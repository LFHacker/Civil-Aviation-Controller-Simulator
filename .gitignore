# Godot 4
.godot/
.import/
export/
export_presets.cfg
*.translation

# 本地产物
screenshots/
build/
*.log

# Blender 备份文件
*.blend1

# 从 docx/ 里抽出来的纯文本副本（阅读用，原始 docx 才是源）
docx/_extracted/

# Godot 4.4+ 生成的文件 ID 缓存（本地可重建，不入库）
*.uid

# 语音识别助手（用 csc 现场编译，见 tools/test-listen.ps1）
tools/atc-listen/*.exe

# 语音片段是离线生成的产物（tools/gen_voice.py），音色来源与许可证见 docs/voice-design.md
assets/audio/phrases/
